{
	"format_version": "1.10.0",
	"minecraft:client_entity": {
		"description": {
			"identifier": "apotso:linger",
			"materials": {
				"default": "vex"
			},
			"textures": {
				"default": "textures/entity/linger",
				"charging": "textures/entity/vex/vex_charging"
			},
			"geometry": {
				"default": "geometry.vex.v1.8"
			},
			"scripts": {
				"pre_animation": [
				  "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;",
				  "variable.empty_handed  = !query.is_item_equipped(0) && !query.is_item_equipped(1);"
				],
				"animate": [
					{"vex_charge": "query.is_charging"},
					{"vex_idle": "query.is_idling"},
					"look_at_target_default"
				],
				"scale": "1.5"
			  },
			  "animations": {
				"look_at_target_default": "animation.humanoid.look_at_target.default",
				"vex_charge": "animation.vex.charge",
				"vex_idle": "animation.vex.idle"
			  },
			"render_controllers": [ "controller.render.vex" ],
			"spawn_egg": {
				"base_color": "#55f9f3",
				"overlay_color": "#b0dfe2"
			}
		}
	}
}