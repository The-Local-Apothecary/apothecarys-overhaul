{
	"format_version": "1.8.0",
	"render_controllers": {
		"controller.render.armor_dyeable": {
			"geometry": "Geometry.default",
			"materials": [
				{
					"*": "variable.is_dyed ? Material.dyed : Material.default"
				}
			],
			"textures": [
				"variable.is_dyed ? Texture.dyed : Texture.default"
			],
			"ignore_lighting": false
		}
	}
}