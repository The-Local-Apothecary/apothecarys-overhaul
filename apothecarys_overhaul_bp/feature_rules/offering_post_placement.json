{
	"format_version": "1.13.0",
	"minecraft:feature_rules": {
		"description": {
			"identifier": "apotso:offering_post_placement",
			"places_feature": "apotso:offering_post_feature"
		},
		"conditions": {
			"placement_pass": "first_pass",
			"minecraft:biome_filter": {
				"all_of":[
                    {
                        "test": "has_biome_tag",
				        "operator": "==",
				        "value": "forest"
                    },
                    {
                        "test": "has_biome_tag",
				        "operator": "!=",
				        "value": "cold"
                    },
                    {
                        "test": "has_biome_tag",
				        "operator": "==",
				        "value": "overworld"
                    }
                ]
			}
		},
		"distribution": {
			"iterations": 1,
			"x": {
				"extent": [0, 16],
				"distribution": "uniform"
			},
			"y": "q.heightmap(v.worldx, v.worldz)", //Generates the feature on the highest block on the column
			"z": {
				"extent": [0, 16],
				"distribution": "uniform"
			},
			"scatter_chance": {
				"numerator": 1,
				"denominator": 25
			}
		}
	}
}